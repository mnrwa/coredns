# Пример .env для DNS-ноды. deploy.ps1 собирает его сам из inventory.json и корневого .env,
# руками нужен только если поднимаешь ноду без скрипта. Права на сервере: chmod 600 .env

# --- обязательные
NODE_IP=192.168.1.10              # IP этой ноды: на нём слушают CoreDNS и админка
DNS_ZONE=example.local            # зона, совпадает с "zone" в config/records.json
ADMIN_PASSWORD=change-me          # секрет, общий для всех DNS-нод (по нему же синхронизация)

# --- необязательные (тут значения по умолчанию)
ADMIN_USER=admin
ADMIN_PORT=9053
DNS_PORT=53
DNS_UPSTREAM=/etc/resolv.conf     # куда отправлять остальные запросы: IP или файл resolv.conf
ZONE_RELOAD=2s                    # как часто CoreDNS перечитывает зону
COREDNS_IMAGE=coredns/coredns:1.12.0
PYTHON_IMAGE=python:3.12-slim
RUN_UID=1000                      # от кого крутится health-check (владелец папок config/ и zones/)
RUN_GID=1000
